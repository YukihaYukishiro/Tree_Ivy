{
  "manifest_version": 3,
  "name": "Tree_Ivy",
  "version": "1.3",
  "description": "スタログ用出欠管理拡張システム",
  "permissions": [
    "storage"
  ],
  "background" : {
    "service_worker" : "backgrounds/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://portal.iwasaki.ac.jp/lms/"
      ],
      "js": [
        "backgrounds/schedule.js",
        "backgrounds/attendFromTop.js",
        "backgrounds/schedule/cellLayout.js",
        "backgrounds/autologin.js",
        "backgrounds/splitview.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://portal.iwasaki.ac.jp/lms/"
      ],
      "css": [
        "css/style.css"
      ]
    },
    {
      "matches":[
        "*://portal.iwasaki.ac.jp/portal/lmsinc/sMyPage.php"
      ],
      "js":[
        "backgrounds/mypage/sMyPage.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "html/dialog.html" ,"images/attend.jpg"],
      "matches": [ "*://portal.iwasaki.ac.jp/*" ]
    }
  ],
  "action": {
    "default_popup": "html/popup.html"
  },
  "icons": {
    "16": "images/16x16.png",
    "48": "images/48x48.png",
    "128": "images/128x128.png"
  }
}