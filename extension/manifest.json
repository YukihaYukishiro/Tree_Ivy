{
  "manifest_version": 3,
  "name": "Tree_Ivy_Openβ",
  "version": "0.4",
  "description": "スタログ用出欠管理拡張システム",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://portal.iwasaki.ac.jp/portal/lmsinc/sMyPage.php*"
      ],
      "js": [
        "backgrounds/mypage.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://portal.iwasaki.ac.jp/lms/"
      ],
      "js": [
        "backgrounds/schedule.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://portal.iwasaki.ac.jp/lms/"
      ],
      "css": [
        "css/style.css"
      ]
    }
  ],
  "action": {
    "default_popup": "html/popup.html"
  },

  "icons": {
    "16": "images/16x16.png",
    "48": "images/48x48.png",
    "128": "images/128x128.png"
  }
}